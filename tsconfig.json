{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./lib",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "commonjs",
    "target": "esnext",
    "types": ["node", "jest"],
    // For nodejs:
    "lib": ["es6", "dom", "ES2021.String"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    "noUnusedLocals": true, // Выдаёт ошибку, если в файле объявлена локальная переменная, которая нигде не используется. Помогает убирать мёртвый код.
    "noUnusedParameters": true, // Выдаёт ошибку, если параметр функции объявлен, но не используется. Помогает избежать неаккуратных сигнатур
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true, // Включает максимальную строгость проверок TypeScript. Включает strictNullChecks, noImplicitAny, strictFunctionTypes и другие строгие опции. Рекомендуется для надёжного кода.
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
